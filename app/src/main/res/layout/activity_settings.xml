<?xml version="1.0" encoding="utf-8"?>

<!-- Hosts the settings screen and navigation drawer. -->
<androidx.drawerlayout.widget.DrawerLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/drawerLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:ignore="VisualLintBounds">

    <!-- Holds settings content and the fixed Back button. -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

        <!-- Scrollable settings content. -->
        <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

            <!-- Holds all settings controls. -->
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    tools:ignore="VisualLintButtonSize,VisualLintTextFieldSize">

                <!-- Screen heading. -->
                <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_title"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                <!-- Enables expiry alerts. -->
                <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchExpiryAlerts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:minHeight="48dp"
                        android:text="@string/expiry_alerts" />

                <!-- Accepts the expiry warning period. -->
                <EditText
                        android:id="@+id/inputExpiryDays"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:hint="@string/expiry_days"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:minHeight="48dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:singleLine="true"
                        tools:ignore="Autofill" />

                <!-- Preferred units heading. -->
                <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/preferred_units"
                        android:textStyle="bold" />

                <!-- Selects the preferred measurement system. -->
                <Spinner
                        android:id="@+id/spinnerPreferredUnits"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="48dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp" />

                <!-- Theme settings heading. -->
                <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/theme_settings"
                        android:textStyle="bold" />

                <!-- Enables dark mode. -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchDarkMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/dark_mode" />

                <!-- Saves the selected settings. -->
                <Button
                        android:id="@+id/btnSaveSettings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:backgroundTint="@color/button_teal"
                        android:minHeight="48dp"
                        android:text="@string/save_settings"
                        android:textAllCaps="false"
                        android:textColor="@color/button_text_dark"
                        tools:ignore="VisualLintButtonSize" />

            </LinearLayout>

        </ScrollView>

        <!-- Returns to the previous screen. -->
        <Button
                android:id="@+id/btnBack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:backgroundTint="@color/button_teal"
                android:minHeight="48dp"
                android:text="@string/back"
                android:textAllCaps="false"
                android:textColor="@color/button_text_dark"
                tools:ignore="VisualLintButtonSize" />

    </LinearLayout>

    <!-- Provides top-level navigation. -->
    <com.google.android.material.navigation.NavigationView
            android:id="@+id/navigationView"
            android:layout_width="280dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:fitsSystemWindows="true"
            app:headerLayout="@layout/nav_header"
            app:menu="@menu/drawer_menu"
            tools:ignore="VisualLintBounds" />

</androidx.drawerlayout.widget.DrawerLayout>