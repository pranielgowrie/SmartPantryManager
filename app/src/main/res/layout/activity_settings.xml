<?xml version="1.0" encoding="utf-8"?>

<!-- Displays and manages the application's configurable settings. -->
<ScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

    <!-- Holds all settings controls in a vertical arrangement. -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

        <!-- Displays the settings screen heading. -->
        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_title"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="28sp"
                android:textStyle="bold" />

        <!-- Enables or disables expiry warning notifications. -->
        <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchExpiryAlerts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/expiry_alerts" />

        <!-- Accepts the number of days before an item is considered expiring soon. -->
        <EditText
                android:id="@+id/inputExpiryDays"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/expiry_days"
                android:importantForAutofill="no"
                android:inputType="number"
                android:singleLine="true" />

        <!-- Displays the preferred measurement system heading. -->
        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/preferred_units"
                android:textStyle="bold" />

        <!-- Allows the user to select a preferred measurement system. -->
        <Spinner
                android:id="@+id/spinnerPreferredUnits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

        <!-- Displays the theme settings heading. -->
        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/theme_settings"
                android:textStyle="bold" />

        <!-- Enables or disables the application's dark theme. -->
        <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchDarkMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/dark_mode" />

        <!-- Validates and saves the selected settings. -->
        <Button
                android:id="@+id/btnSaveSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/save_settings"
                android:textAllCaps="false" />

    </LinearLayout>

</ScrollView>