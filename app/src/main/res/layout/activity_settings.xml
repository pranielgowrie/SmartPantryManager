<?xml version="1.0" encoding="utf-8"?>

<ScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

    <!-- Holds the settings controls. -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

        <!-- Displays the screen title. -->
        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_title"
                android:textSize="26sp"
                android:textStyle="bold" />

        <!-- Enables or disables expiry alerts. -->
        <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchExpiryAlerts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/expiry_alerts" />

        <!-- Sets the expiry warning period. -->
        <EditText
                android:id="@+id/inputExpiryDays"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/expiry_days"
                android:inputType="number"
                android:singleLine="true" />

        <!-- Labels the preferred units control. -->
        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/preferred_units"
                android:textStyle="bold" />

        <!-- Selects the preferred measurement system. -->
        <Spinner
                android:id="@+id/spinnerPreferredUnits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

        <!-- Saves the selected settings. -->
        <Button
                android:id="@+id/btnSaveSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/save_settings"
                android:textAllCaps="false" />

    </LinearLayout>

</ScrollView>