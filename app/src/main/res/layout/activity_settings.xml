<?xml version="1.0" encoding="utf-8"?>

<ScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

    <!-- Holds all settings controls. -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

        <!-- Screen title. -->
        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_title"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="28sp"
                android:textStyle="bold" />

        <!-- Enables or disables expiry alerts. -->
        <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchExpiryAlerts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/expiry_alerts" />

        <!-- Expiry warning period. -->
        <EditText
                android:id="@+id/inputExpiryDays"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/expiry_days"
                android:importantForAutofill="no"
                android:inputType="number"
                android:singleLine="true" />

        <!-- Preferred units heading. -->
        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/preferred_units"
                android:textStyle="bold" />

        <!-- Preferred measurement system. -->
        <Spinner
                android:id="@+id/spinnerPreferredUnits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

        <!-- Theme settings heading. -->
        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/theme_settings"
                android:textStyle="bold" />

        <!-- Dark mode toggle. -->
        <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchDarkMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/dark_mode" />

        <!-- Saves the selected settings. -->
        <Button
                android:id="@+id/btnSaveSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/save_settings"
                android:textAllCaps="false" />

    </LinearLayout>

</ScrollView>