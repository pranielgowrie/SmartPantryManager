<?xml version="1.0" encoding="utf-8"?>

<!-- Displays and manages the pantry inventory. -->
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

    <!-- Displays the pantry heading. -->
    <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pantry_title"
            android:textSize="28sp"
            android:textStyle="bold" />

    <!-- Displays feedback when the pantry is empty. -->
    <TextView
            android:id="@+id/txtPantryEmpty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/pantry_empty_message"
            android:textAlignment="center"
            android:textSize="16sp"
            android:visibility="gone" />

    <!-- Displays pantry items. -->
    <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/pantryList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />

    <!-- Opens the ingredient form. -->
    <Button
            android:id="@+id/btnAdd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/add_ingredient"
            android:textAllCaps="false" />

</LinearLayout>