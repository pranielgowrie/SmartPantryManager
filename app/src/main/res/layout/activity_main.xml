<?xml version="1.0" encoding="utf-8"?>

<!-- Hosts the pantry screen and navigation drawer. -->
<androidx.drawerlayout.widget.DrawerLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/drawerLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:openDrawer="start">

    <!-- Displays the pantry content. -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

        <!-- Screen heading. -->
        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pantry_title"
                android:textSize="28sp"
                android:textStyle="bold" />

        <!-- Displays feedback when the pantry is empty. -->
        <TextView
                android:id="@+id/txtPantryEmpty"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/pantry_empty_message"
                android:textAlignment="center"
                android:textSize="16sp"
                android:visibility="gone" />

        <!-- Displays the scrollable pantry list. -->
        <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/pantryList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="8dp" />

        <!-- Opens the ingredient form. -->
        <Button
                android:id="@+id/btnAdd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/add_ingredient"
                android:textAllCaps="false" />

        <!-- Returns to the previous screen. -->
        <Button
                android:id="@+id/btnBack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/back"
                android:textAllCaps="false" />

    </LinearLayout>

    <!-- Provides top-level application navigation. -->
    <com.google.android.material.navigation.NavigationView
            android:id="@+id/navigationView"
            android:layout_width="280dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:fitsSystemWindows="true"
            app:headerLayout="@layout/nav_header"
            app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>