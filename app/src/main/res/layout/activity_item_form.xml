<?xml version="1.0" encoding="utf-8"?>

<ScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

    <!-- Holds the pantry item form controls. -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

        <!-- Ingredient name input. -->
        <EditText
                android:id="@+id/inputName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/ingredient_name"
                android:inputType="textCapWords"
                android:maxLength="60"
                android:singleLine="true" />

        <!-- Ingredient quantity input. -->
        <EditText
                android:id="@+id/inputQuantity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/quantity"
                android:inputType="numberDecimal"
                android:singleLine="true" />

        <!-- Measurement unit selection. -->
        <Spinner
                android:id="@+id/spinnerUnit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

        <!-- Optional expiry date input. -->
        <EditText
                android:id="@+id/inputExpiry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/expiry_hint"
                android:inputType="date"
                android:singleLine="true" />

        <!-- Saves the new or edited pantry item. -->
        <Button
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/save_item"
                android:textAllCaps="false" />

    </LinearLayout>

</ScrollView>
