<?xml version="1.0" encoding="utf-8"?>

<!-- Hosts suggested recipes and drawer navigation. -->
<androidx.drawerlayout.widget.DrawerLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/drawerLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <!-- Displays the suggestions content. -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

        <!-- Screen heading -->
        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/suggestions_title"
                android:textSize="28sp"
                android:textStyle="bold" />

        <!-- Screen description -->
        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/suggestions_subtitle"
                android:textSize="14sp" />

        <!-- Empty-state feedback -->
        <TextView
                android:id="@+id/txtSuggestionsEmpty"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/suggestions_empty"
                android:textAlignment="center"
                android:textSize="16sp"
                android:visibility="gone" />

        <!-- Scrollable recipe list -->
        <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recipeList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="8dp" />

        <!-- Returns to the previous screen -->
        <Button
                android:id="@+id/btnBack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/back"
                android:textAllCaps="false" />

    </LinearLayout>

    <!-- Displays drawer navigation -->
    <com.google.android.material.navigation.NavigationView
            android:id="@+id/navigationView"
            android:layout_width="280dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:fitsSystemWindows="true"
            app:headerLayout="@layout/nav_header"
            app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
