<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

    <!-- Displays the screen title. -->
    <TextView
            android:id="@+id/txtSuggestionsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/suggestions_title"
            android:textSize="26sp"
            android:textStyle="bold" />

    <!-- Explains the strict matching rule. -->
    <TextView
            android:id="@+id/txtSuggestionsSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/suggestions_subtitle"
            android:textSize="15sp" />

    <!-- Displays recipes that fully match the pantry. -->
    <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recipeList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />

    <!-- Displays feedback when no recipes match. -->
    <TextView
            android:id="@+id/txtSuggestionsEmpty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/suggestions_empty"
            android:textSize="16sp"
            android:visibility="gone" />

</LinearLayout>