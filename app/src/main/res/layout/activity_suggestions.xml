<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

    <!-- Displays the screen title. -->
    <TextView
            android:id="@+id/txtSuggestionsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/suggestions_title"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="28sp"
            android:textStyle="bold" />

    <!-- Explains how recipe matching works. -->
    <TextView
            android:id="@+id/txtSuggestionsSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/suggestions_subtitle"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="15sp" />

    <!-- Displays matching recipes. -->
    <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recipeList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="8dp"
            android:scrollbars="vertical" />

    <!-- Displayed when no recipes match the pantry. -->
    <TextView
            android:id="@+id/txtSuggestionsEmpty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/suggestions_empty"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="16sp"
            android:visibility="gone" />

</LinearLayout>