<?xml version="1.0" encoding="utf-8"?>

<resources>

    <!-- Dark theme configuration. -->
    <style
            name="Theme.SmartPantryManager"
            parent="Theme.MaterialComponents.DayNight.DarkActionBar">

        <!-- Primary neon mint colour. -->
        <item name="colorPrimary">
            @color/primary_neon
        </item>

        <!-- Secondary neon blue colour. -->
        <item name="colorPrimaryVariant">
            @color/secondary_neon
        </item>

        <!-- Accent purple colour. -->
        <item name="colorSecondary">
            @color/accent_purple
        </item>

        <!-- Text displayed on primary components. -->
        <item name="colorOnPrimary">
            @color/white
        </item>

        <!-- Text displayed on secondary components. -->
        <item name="colorOnSecondary">
            @color/white
        </item>

        <!-- Dark status bar colour. -->
        <item name="android:statusBarColor">
            @color/background_dark
        </item>

    </style>

</resources>