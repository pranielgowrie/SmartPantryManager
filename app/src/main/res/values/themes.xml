<?xml version="1.0" encoding="utf-8"?>

<resources>

    <!-- Defines the main application theme. -->
    <style
            name="Theme.SmartPantryManager"
            parent="Theme.MaterialComponents.DayNight.DarkActionBar">

        <!-- Primary application colours. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary application colours. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Applies the darker primary colour to the status bar. -->
        <item name="android:statusBarColor">
            ?attr/colorPrimaryVariant
        </item>

        <!-- Uses a light navigation bar with dark controls. -->
        <item name="android:navigationBarColor">
            @color/white
        </item>

        <item name="android:windowLightNavigationBar">
            true
        </item>

    </style>

</resources>