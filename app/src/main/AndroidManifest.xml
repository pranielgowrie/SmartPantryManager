<?xml version="1.0" encoding="utf-8"?>

<!-- Declares the application and its activities. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
            android:allowBackup="true"
            android:label="@string/app_name"
            android:supportsRtl="true"
            android:theme="@style/Theme.SmartPantryManager">

        <!-- Displays application settings. -->
        <activity
                android:name=".activities.SettingsActivity"
                android:exported="false" />

        <!-- Displays recipe details. -->
        <activity
                android:name=".activities.RecipeActivity"
                android:exported="false" />

        <!-- Displays strictly matched recipes. -->
        <activity
                android:name=".activities.SuggestionsActivity"
                android:exported="false" />

        <!-- Adds and edits pantry items. -->
        <activity
                android:name=".activities.ItemFormActivity"
                android:exported="false" />

        <!-- Launches the pantry screen. -->
        <activity
                android:name=".MainActivity"
                android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

    </application>

</manifest>